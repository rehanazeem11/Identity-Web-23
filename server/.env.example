# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it holds secrets.

PORT=4000

# MongoDB Atlas — Atlas dashboard > Database > Connect > Drivers (copy the
# connection string and swap in your database user's password)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/identity-living?retryWrites=true&w=majority

# Where your frontend is hosted, so CORS allows it. Use * only for local testing.
FRONTEND_ORIGIN=http://localhost:5500

# Razorpay — Dashboard > Settings > API Keys (Generate Test or Live keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: Razorpay Webhooks — Dashboard > Settings > Webhooks (Secret entered when configuring webhook)
RAZORPAY_WEBHOOK_SECRET=

# Gmail SMTP — Google Account > Security > 2-Step Verification > App Passwords
# (2-Step Verification must be ON to generate an App Password)
GMAIL_USER=identityliving.co@gmail.com
GMAIL_APP_PASSWORD=
# Optional: also email the store owner on every new order
STORE_OWNER_EMAIL=identityliving.co@gmail.com

# Meta WhatsApp Cloud API — developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Name of your approved message template (must be pre-approved in Meta Business Manager)
WHATSAPP_TEMPLATE_NAME=order_confirmation
# Optional: also WhatsApp the store owner on every new order (E.164 format, no +)
STORE_OWNER_WHATSAPP=

# Shared secret the admin dashboard sends to read order data. Make up any long random string.
ADMIN_API_KEY=
